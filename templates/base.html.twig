<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MCP Portal{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo.svg') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    {% if app.user %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="{{ path('app_project_index') }}">
                <img src="{{ asset('images/logo.svg') }}" alt="" width="24" height="24">
                MCP Portal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_project' ? 'active' : '' }}"
                           href="{{ path('app_project_index') }}">
                            <i class="bi bi-folder2 me-1"></i>{{ 'nav.projects'|trans }}
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <span class="badge bg-warning text-dark">Admin</span>
                    </li>
                    {% endif %}
                    <li class="nav-item">
                        <span class="nav-link text-light">
                            <i class="bi bi-person-circle me-1"></i>{{ app.user.email }}
                        </span>
                    </li>

                    {# ── Locale switcher ────────────────────────────────── #}
                    <li class="nav-item dropdown">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-label="{{ 'locale.label'|trans }}">
                            {{ app.request.locale == 'fr' ? '🇫🇷' : '🇬🇧' }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form method="post" action="{{ path('app_locale_switch', {locale: 'en'}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('locale-switch') }}">
                                    <button type="submit" class="dropdown-item {{ app.request.locale == 'en' ? 'active' : '' }}">
                                        🇬🇧 {{ 'locale.en'|trans }}
                                    </button>
                                </form>
                            </li>
                            <li>
                                <form method="post" action="{{ path('app_locale_switch', {locale: 'fr'}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('locale-switch') }}">
                                    <button type="submit" class="dropdown-item {{ app.request.locale == 'fr' ? 'active' : '' }}">
                                        🇫🇷 {{ 'locale.fr'|trans }}
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm" href="{{ path('app_logout') }}">
                            <i class="bi bi-box-arrow-right me-1"></i>{{ 'nav.logout'|trans }}
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    {% endif %}

    <main class="flex-grow-1">
        <div class="container py-4">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                        {{ message|trans }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </main>

    <footer class="text-center text-muted py-3 border-top bg-white">
        <small>&copy; {{ "now"|date("Y") }} MCP Portal</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
