<hr class="my-3">
<h6 class="text-muted small text-uppercase fw-semibold mb-1">
    <i class="bi bi-bar-chart me-1"></i>{{ 'form.mcp.castopod.op3_section'|trans }}
    <span class="badge bg-secondary fw-normal ms-1" style="font-size:.7rem">{{ 'locale.optional'|trans }}</span>
</h6>
<p class="text-muted small mb-3">
    {{ 'form.mcp.castopod.op3_hint'|trans|raw }}
</p>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        {{ form_label(form.castopodOp3ApiKey) }}
        {{ form_widget(form.castopodOp3ApiKey) }}
        {{ form_errors(form.castopodOp3ApiKey) }}
    </div>
    <div class="col-md-6">
        {{ form_label(form.castopodOp3ShowUuid) }}
        {{ form_widget(form.castopodOp3ShowUuid) }}
        {{ form_errors(form.castopodOp3ShowUuid) }}
    </div>
</div>

{% endif %}

<button type="submit" class="btn btn-dark w-100">
    <i class="bi bi-check-lg me-1"></i>{{ 'action.save'|trans }}
</button>

{{ form_end(form) }}

{# ── Test connection scripts ──────────────────────────────────────────────── #}
{% if server_type.value == 'matomo' %}
<script nonce="{{ csp_nonce() }}">
document.getElementById('btn-test-matomo').addEventListener('click', function () {
    const btn      = this;
    const resultEl = document.getElementById('test-matomo-result');

    const url      = document.getElementById('{{ form.matomoUrl.vars.id }}').value;
    const apiToken = document.getElementById('{{ form.matomoApiToken.vars.id }}').value;
    const siteId   = document.getElementById('{{ form.matomoSiteId.vars.id }}').value;

    if (!url || !apiToken || !siteId) {
        resultEl.innerHTML = '<span class="text-danger small">{{ 'error.fill_connection_fields'|trans|e('js') }}</span>';
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>{{ 'action.testing'|trans|e('js') }}';
    resultEl.innerHTML = '';

    fetch('/api/{{ server_type.value }}/test', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ url, apiToken, siteId: parseInt(siteId) }),
    })
        .then(r => r.json())
        .then(data => {
            resultEl.innerHTML = data.success
                ? '<span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>' + data.message + '</span>'
                : '<span class="badge bg-danger"><i class="bi bi-x-lg me-1"></i>' + data.message + '</span>';
        })
        .catch(() => {
            resultEl.innerHTML = '<span class="badge bg-danger">{{ 'error.network'|trans|e('js') }}</span>';
        })
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-wifi me-1"></i>{{ 'action.test_connection'|trans|e('js') }}';
        });
});
</script>

