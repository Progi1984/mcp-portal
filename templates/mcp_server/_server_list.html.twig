{% if servers is empty %}
    <div class="text-center py-5 text-muted border rounded bg-white mt-4">
        <i class="bi bi-plug fs-1 d-block mb-3"></i>
        <p class="mb-3">{{ 'mcp.no_servers'|trans }}</p>
        <a href="{{ path('app_mcp_new', {projectId: project.id}) }}" class="btn btn-dark">
            <i class="bi bi-plus-lg me-1"></i>{{ 'mcp.connect_server_btn'|trans }}
        </a>
    </div>
{% else %}
    <div class="d-flex flex-column gap-3">
        {% for server in servers %}
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-dark me-2 d-inline-flex align-items-center gap-1">
                                <img src="{{ asset('images/connectors/' ~ server.type.icon()) }}" alt="" width="14" height="14" style="filter: invert(1);">
                                {{ server.type.label() }}
                            </span>
                            <h6 class="mb-0 fw-semibold">{{ server.name }}</h6>
                        </div>
                        <p class="text-muted small mb-1">{{ 'mcp.endpoint'|trans }}</p>
                        <div class="input-group input-group-sm" style="max-width: 520px;">
                            <input type="text" class="form-control font-monospace bg-light"
                                   id="endpoint-{{ server.id }}"
                                   value="{{ url('app_mcp_endpoint', {token: server.accessToken}) }}"
                                   readonly>
                            <button class="btn btn-outline-secondary"
                                    data-copy="endpoint-{{ server.id }}" type="button"
                                    title="{{ 'action.copy'|trans }}">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                        <p class="text-muted small mb-1 mt-2">{{ 'mcp.client_secret'|trans }}</p>
                        <div class="input-group input-group-sm" style="max-width: 520px;">
                            <span class="input-group-text text-muted small">Bearer</span>
                            <input type="password" class="form-control font-monospace bg-light"
                                   id="secret-{{ server.id }}"
                                   value="{{ server.clientSecret }}"
                                   readonly>
                            <button class="btn btn-outline-secondary"
                                    data-toggle-secret="secret-{{ server.id }}" type="button"
                                    title="{{ 'action.show_secret'|trans }}">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn btn-outline-secondary"
                                    data-copy="secret-{{ server.id }}" type="button"
                                    title="{{ 'action.copy'|trans }}">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex flex-wrap gap-2 justify-content-md-end mt-3 mt-md-0">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-test-server="{{ server.id }}" data-server-type="{{ server.type.value }}">
                            <i class="bi bi-wifi me-1"></i>{{ 'action.test'|trans }}
                        </button>
                        <span id="test-result-{{ server.id }}" class="align-self-center small"></span>

                        <a href="{{ path('app_mcp_edit', {projectId: project.id, id: server.id}) }}"
                           class="btn btn-sm btn-outline-dark">
                            <i class="bi bi-pencil me-1"></i>{{ 'action.edit'|trans }}
                        </a>

                        <form method="post"
                              action="{{ path('app_mcp_regenerate_token', {projectId: project.id, id: server.id}) }}"
                              data-confirm="{{ 'mcp.regenerate_confirm'|trans }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('regenerate-' ~ server.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-warning" title="{{ 'action.new_token'|trans }}">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </form>

                        <form method="post"
                              action="{{ path('app_mcp_regenerate_secret', {projectId: project.id, id: server.id}) }}"
                              data-confirm="{{ 'mcp.regenerate_secret_confirm'|trans }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('regenerate-secret-' ~ server.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-warning" title="{{ 'action.new_secret'|trans }}">
                                <i class="bi bi-shield-lock"></i>
                            </button>
                        </form>

                        <form method="post"
                              action="{{ path('app_mcp_delete', {projectId: project.id, id: server.id}) }}"
                              data-confirm="{{ 'mcp.delete_confirm'|trans }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-mcp-' ~ server.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ 'action.delete'|trans }}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
