{% extends 'base.html.twig' %}

{% block title %}{{ 'mcp.servers_title'|trans }} - {{ project.name }}{% endblock %}

{% block body %}
<div class="d-flex align-items-center mb-2">
    <a href="{{ path('app_project_index') }}" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h2 class="mb-0">{{ 'mcp.servers_title'|trans }}</h2>
        <p class="text-muted small mb-0">{{ project.name }}</p>
    </div>
    <a href="{{ path('app_mcp_new', {projectId: project.id}) }}" class="btn btn-dark ms-auto">
        <i class="bi bi-plus-lg me-1"></i>{{ 'mcp.connect_server'|trans }}
    </a>
</div>

{% include 'mcp_server/_server_list.html.twig' %}
{% endblock %}

{% block javascripts %}
{% include 'mcp_server/_server_list_js.html.twig' %}
{% endblock %}
