{% extends 'base.html.twig' %}

{% block title %}{{ 'mcp.new.title'|trans }} - {{ project.name }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="d-flex align-items-center mb-4">
            <a href="{{ path('app_mcp_new', {projectId: project.id}) }}" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h2 class="mb-0">{{ 'mcp.new.title'|trans }}</h2>
                <p class="text-muted small mb-0">
                    {{ project.name }} &rsaquo;
                    <img src="{{ asset('images/connectors/' ~ server_type.icon()) }}"
                         width="14" height="14"
                         alt=""
                         class="me-1"
                         style="vertical-align:text-bottom;object-fit:contain">{{ server_type.label() }}
                </p>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                {% include 'mcp_server/_form.html.twig' %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
