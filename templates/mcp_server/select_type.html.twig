{% extends 'base.html.twig' %}

{% block title %}{{ 'mcp.new.connect_title'|trans }} - {{ project.name }}{% endblock %}

{% block body %}
<div class="d-flex align-items-center mb-4">
    <a href="{{ path('app_project_show', {id: project.id}) }}" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h2 class="mb-0">{{ 'mcp.new.connect_title'|trans }}</h2>
        <p class="text-muted small mb-0">{{ project.name }}</p>
    </div>
</div>

<p class="text-muted mb-4">{{ 'mcp.new.select_type_hint'|trans }}</p>

<div class="row g-3">
    {% for type in types %}
    <div class="col-md-6 col-lg-4">
        <a href="{{ path('app_mcp_new_type', {projectId: project.id, type: type.value}) }}"
           class="card border-0 shadow-sm h-100 text-decoration-none text-dark">
            <div class="card-body d-flex align-items-start gap-3 p-4">
                <div class="bg-white border rounded p-2 flex-shrink-0 d-flex align-items-center justify-content-center" style="width:40px;height:40px">
                    <img src="{{ asset('images/connectors/' ~ type.icon()) }}"
                         width="24" height="24"
                         alt="{{ type.label() }}"
                         style="object-fit:contain">
                </div>
                <div>
                    <h5 class="mb-1">{{ type.label() }}</h5>
                    <p class="text-muted small mb-0">{{ type.descriptionKey()|trans }}</p>
                </div>
            </div>
            <div class="card-footer bg-transparent border-top text-end">
                <span class="text-dark small fw-semibold">
                    {{ 'action.configure'|trans }} <i class="bi bi-arrow-right ms-1"></i>
                </span>
            </div>
        </a>
    </div>
    {% endfor %}
</div>
{% endblock %}
