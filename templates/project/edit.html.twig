{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} - MCP Portal{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="d-flex align-items-center mb-4">
            <a href="{{ path('app_project_index') }}" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="mb-0">{{ 'project.edit.title'|trans }}</h2>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="mb-3 p-3 bg-light rounded">
                    <p class="text-muted small mb-1">{{ 'project.uuid_label'|trans }}</p>
                    <code class="fs-6">{{ project.id }}</code>
                </div>

                {{ form_start(form) }}
                <div class="mb-4">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>
                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-check-lg me-1"></i>{{ 'action.save_changes'|trans }}
                </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
