{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} - MCP Portal{% endblock %}

{% block body %}
<div class="d-flex align-items-center mb-4">
    <a href="{{ path('app_project_index') }}" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="flex-grow-1">
        <h2 class="mb-0">{{ project.name }}</h2>
        <p class="text-muted small font-monospace mb-0">
            <i class="bi bi-key me-1"></i>{{ project.id }}
        </p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_project_edit', {id: project.id}) }}" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-pencil me-1"></i>{{ 'project.rename'|trans }}
        </a>
    </div>
</div>

{# MCP Servers #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-plug me-2"></i>{{ 'mcp.servers_title'|trans }}</h5>
    <a href="{{ path('app_mcp_new', {projectId: project.id}) }}" class="btn btn-dark btn-sm">
        <i class="bi bi-plus-lg me-1"></i>{{ 'mcp.connect_server'|trans }}
    </a>
</div>

{% include 'mcp_server/_server_list.html.twig' %}
{% endblock %}

{% block javascripts %}
{% include 'mcp_server/_server_list_js.html.twig' %}
{% endblock %}
