{% extends 'base.html.twig' %}

{% block title %}{{ 'register.title'|trans }} - MCP Portal{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-sm-10 col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <h1 class="h3 fw-bold">
                <i class="bi bi-person-plus-fill text-dark"></i> {{ 'register.title'|trans }}
            </h1>
            <p class="text-muted">{{ 'register.subtitle'|trans }}</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first) }}
                    {{ form_errors(form.plainPassword.first) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_widget(form.plainPassword.second) }}
                    {{ form_errors(form.plainPassword.second) }}
                    {{ form_errors(form.plainPassword) }}
                </div>

                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-person-check me-1"></i>{{ 'register.submit'|trans }}
                </button>

                {{ form_end(form) }}
            </div>
        </div>

        <p class="text-center mt-3 text-muted">
            {{ 'register.already_account'|trans }}
            <a href="{{ path('app_login') }}" class="fw-semibold text-dark">{{ 'register.login_link'|trans }}</a>
        </p>
    </div>
</div>
{% endblock %}
